<?xml version="1.0" encoding="utf-8"?>
<!-- Google Play build:
     - no "All files access", so no "remove from gallery" mode;
     - no accessibility service, so no Capture tile or button (Play restricts accessibility services). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:node="remove" />
    <application>
        <service android:name=".Cleanup" tools:node="remove" />
        <service android:name=".CaptureService" tools:node="remove" />
        <service android:name=".CaptureTile" tools:node="remove" />
        <activity android:name=".CaptureSetupActivity" tools:node="remove" />
    </application>
</manifest>
